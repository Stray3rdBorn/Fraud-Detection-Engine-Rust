# the key every request must carry, at least 16 characters.
API_KEY=paste-a-64-character-hex-key-here
# the Garnet address, leave the line out to use the in memory store.
GARNET_URL=redis://:garnet-password@127.0.0.1:6380
# the Postgres address, leave the line out to run without decisions and cases.
DATABASE_URL=postgres://postgres:postgres-password@127.0.0.1:5432/fraud